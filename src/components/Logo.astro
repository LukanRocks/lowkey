---
// Placeholder mark until the vector logo arrives: swap this SVG for the real one.
interface Props {
  size?: number;
  /** Set when the logo appears without the brand name next to it. */
  label?: string;
}
const { size = 36, label } = Astro.props;
---

<svg
  style="text-transform: none"
  width={size}
  height={size}
  viewBox="0 0 40 40"
  {...(label ? { role: 'img', 'aria-label': label } : { 'aria-hidden': 'true' })}
>
  <circle cx="20" cy="20" r="20" fill="#fff200"></circle>
  <text
    x="20"
    y="26.5"
    text-anchor="middle"
    font-family="Archivo, Arial, sans-serif"
    font-weight="900"
    font-size="18"
    letter-spacing="-1"
    fill="#0b0b0b"
  >
    lk
  </text>
</svg>
