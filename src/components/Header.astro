---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { nav } from '../data/site';

const current = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';
---

<header class="header">
  <div class="container bar">
    <a href="/" class="brand">
      <Logo size={34} />
      <span class="wordmark">
        Low Key<span> Estúdios</span>
      </span>
    </a>

    <nav class="desktop-nav" aria-label="Principal">
      {nav.slice(1, 4).map((item) => (
        <a href={item.href} aria-current={current === item.href ? 'page' : undefined}>
          {item.label}
        </a>
      ))}
    </nav>

    <details class="menu">
      <summary aria-label="Abrir menu">
        <Icon name="menu" size={24} class="open" />
        <Icon name="x" size={24} class="close" />
      </summary>
      <nav class="sheet" aria-label="Menu">
        {nav.map((item) => (
          <a href={item.href} aria-current={current === item.href ? 'page' : undefined}>
            {item.label}
            <Icon name="arrow" size={18} />
          </a>
        ))}
      </nav>
    </details>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: rgb(11 11 11 / 0.88);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 60px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    font-weight: 800;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    font-size: 0.95rem;
  }
  .wordmark span {
    color: var(--muted);
    font-weight: 600;
  }
  .desktop-nav {
    display: none;
  }
  .menu summary {
    list-style: none;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-right: -10px;
    cursor: pointer;
  }
  .menu summary::-webkit-details-marker {
    display: none;
  }
  .menu :global(.close),
  .menu[open] :global(.open) {
    display: none;
  }
  .menu[open] :global(.close) {
    display: block;
  }
  .sheet {
    position: absolute;
    left: 0;
    right: 0;
    top: 60px;
    background: var(--bg);
    border-bottom: 1px solid var(--line);
    padding: 8px var(--gutter) 20px;
  }
  .sheet a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px 0;
    font-size: 1.25rem;
    font-weight: 700;
    text-decoration: none;
    border-bottom: 1px solid var(--line);
  }
  .sheet a[aria-current='page'] {
    color: var(--yellow);
  }
  @media (min-width: 900px) {
    .desktop-nav {
      display: flex;
      gap: 28px;
      font-weight: 600;
      font-size: 0.95rem;
    }
    .desktop-nav a {
      text-decoration: none;
      color: var(--muted);
    }
    .desktop-nav a:hover,
    .desktop-nav a[aria-current='page'] {
      color: var(--text);
    }
    .menu {
      display: none;
    }
  }
</style>
