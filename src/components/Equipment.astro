---
import { equipamentos } from '../data/compartilhado';
---

<div class="equip">
  {equipamentos.map((g) => (
    <div>
      <h3>{g.grupo}</h3>
      <ul>
        {g.itens.map((i) => (
          <li>{i}</li>
        ))}
      </ul>
    </div>
  ))}
</div>
<p class="note">
  Incluso no valor da reserva, no Galpão e no Casarão. Confirme a disponibilidade dos itens ao reservar.
</p>

<style>
  .equip {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px 16px;
  }
  h3 {
    margin: 0 0 8px;
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--yellow);
  }
  li {
    font-size: 0.92rem;
    padding: 3px 0;
  }
  .note {
    margin-top: 18px;
    font-size: 0.85rem;
    color: var(--muted);
  }
  @media (min-width: 760px) {
    .equip {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
