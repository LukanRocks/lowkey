---
import Base from '../layouts/Base.astro';
---

<Base title="Página não encontrada" description="Esta página não existe.">
  <section class="section">
    <div class="container stack">
      <span class="eyebrow">Erro 404</span>
      <h1>Página não encontrada</h1>
      <p class="lead">O endereço pode ter mudado. Veja os nossos espaços:</p>
      <div style="display: flex; flex-wrap: wrap; gap: 10px">
        <a class="btn btn-primary" href="/galpao">
          Estúdio Galpão
        </a>
        <a class="btn btn-ghost" href="/casarao">
          Casarão Antigo
        </a>
      </div>
    </div>
  </section>
</Base>
